{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",        // Your source code is in the 'src' folder
    "outDir": "./dist",        // Output compiled JavaScript to the 'dist' folder
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "paths": {
      "@repo/database": ["../../packages/database/src"]
    },
    "skipLibCheck": true
  },
  "include": ["src/**/*"]  
}